<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <assemblyIdentity version="1.0.0.0" name="SparseAppSample.app" type="win32" />

  <!--
    Package identity for the sparse identity package. This <msix> element is what
    connects the running exe to the identity MSIX at runtime. It is maintained here
    (XML mode) and embedded into the exe at build time via <ApplicationManifest>.

    Regenerate/update it after changing appxmanifest.xml with:
        winapp embed-identity app.manifest --manifest appxmanifest.xml
  -->
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=Sparse App Sample"
        packageName="SparseAppSample"
        applicationId="SparseAppSample" />

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

</assembly>
