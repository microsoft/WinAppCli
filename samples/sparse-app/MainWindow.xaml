<Window x:Class="sparse_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:sparse_app"
        mc:Ignorable="d"
        Title="Sparse Packaging Sample" Height="320" Width="640">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Sparse Packaging Sample" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusTextBlock" Margin="0,24,0,8" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock x:Name="DetailTextBlock" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
