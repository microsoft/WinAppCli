<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:v="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:restricted="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:d="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:v10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  IgnorableNamespaces="v restricted d v10">

  <Identity
    Name="UnusualNS"
    Publisher="CN=UnusualNS"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>UnusualNS</DisplayName>
    <PublisherDisplayName>UnusualNS Publisher</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="UnusualNS.exe" EntryPoint="Windows.FullTrustApplication" v10:TrustLevel="mediumIL" v10:RuntimeBehavior="packagedClassicApp">
      <v:VisualElements
        DisplayName="UnusualNS"
        Description="App using non-standard namespace prefixes"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <v:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </v:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <restricted:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
