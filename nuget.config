<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <clear />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Prerelease NuGet client libraries (7.9.0-rc) required for Native AOT (see
         Directory.Packages.props). Remove once a 7.8+ stable with the System.Text.Json
         deserializer ships to nuget.org. -->
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Package Source Mapping pins each package to exactly one feed — the recommended mitigation
         against dependency-confusion/substitution attacks when more than one source is configured.
         Only the prerelease NuGet.* client libraries resolve from dotnet-tools; everything else
         resolves from nuget.org. -->
    <packageSource key="dotnet-tools">
      <package pattern="NuGet.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>